<?xml version="1.0" encoding="utf-8"?>
<!--
    muxway: the time and the board. Four rows are complication slots bound to the
    muxway app's row complications, the foot to its summary; any face with slots can
    show the same. The face has no code: colour comes from the value each row carries
    (0 dim, 1 ink, 2 attention). Virtual canvas 450 x 450, round.
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="14:07:00"/>

    <!-- ink, dim, attention, faint, background -->
    <UserConfigurations>
        <ColorConfiguration id="theme" displayName="theme_label" defaultValue="1">
            <ColorOption id="1" displayName="theme_amber" colors="#FFB000 #A06C00 #FFD36B #4A3200 #0A0603"/>
            <ColorOption id="0" displayName="theme_green" colors="#39FF14 #1F8F14 #FFB000 #0F4A0C #050806"/>
            <ColorOption id="2" displayName="theme_paper" colors="#1F2A1F #5A6A5A #9A5B00 #B9B39F #F1EAD8"/>
        </ColorConfiguration>
    </UserConfigurations>

    <Scene backgroundColor="#FF000000">
        <PartDraw x="0" y="0" width="450" height="450" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="0"/>
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="[CONFIGURATION.theme.4]"/>
            </Rectangle>
        </PartDraw>

        <DigitalClock x="0" y="52" width="450" height="76">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="76" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="130"/>
                <Font family="press_start_2p" size="54" color="[CONFIGURATION.theme.0]"/>
            </TimeText>
        </DigitalClock>

        <PartText x="0" y="130" width="450" height="26" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="90"/>
            <Text align="CENTER" maxLines="1">
                <Font family="dejavu_sans_mono" size="19" color="[CONFIGURATION.theme.1]">
                    <Template>%s %d %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[MONTH_S]"/></Template>
                </Font>
            </Text>
        </PartText>

        <PartDraw x="0" y="0" width="450" height="450" alpha="255">
            <Variant mode="AMBIENT" target="alpha" value="90"/>
            <Line startX="70" startY="160" endX="380" endY="160">
